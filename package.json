{
 "name": "js-ui-lab",
 "private": true,
 "version": "0.0.0",
 "type": "module",
 "scripts": {
  "lint:js": "eslint .",
  "lint:js:fix": "eslint . --fix",
  "lint:scss": "stylelint \"**/*.scss\"",
  "lint:scss:fix": "stylelint \"**/*.scss\" --fix",
  "format": "prettier --write .",
  "dev": "vite",
  "prebuild": "node ./plugins/genFormats.js",
  "build": "vite build",
  "preview": "vite preview",
  "lint": "npm run lint:js ; npm run lint:scss",
  "lint:fix": "npm run lint:js:fix ; npm run lint:scss:fix ; npm run format"
 },
 "devDependencies": {
  "@eslint/js": "10.0.1",
  "eslint": "10.12.0",
  "eslint-config-prettier": "10.1.8",
  "globals": "17.13.0",
  "prettier": "3.9.10",
  "sass": "1.105.1",
  "sharp": "0.35.5",
  "stylelint": "17.16.0",
  "stylelint-config-recess-order": "7.8.0",
  "stylelint-config-standard-scss": "17.0.0",
  "stylelint-order": "8.1.2",
  "stylelint-scss": "7.3.0",
  "vite": "8.3.4",
  "vite-plugin-image-optimizer": "2.0.3",
  "vite-plugin-svg-icons": "2.0.1"
 }
}
